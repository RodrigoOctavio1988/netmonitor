# ============================================================
# NetMonitor Backend — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores.
# ============================================================

# Porta do servidor Express + WebSocket
PORT=3001

# --- Configurações de Segurança ---
# Origens permitidas para CORS (separadas por vírgula se mais de uma)
CORS_ORIGIN=http://localhost:5173

# Limites de requisições por IP na API (rate limiting)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Autenticação Básica ---
# Defina AUTH_ENABLED=true para proteger as rotas da API com usuário/senha.
# O frontend pedirá credenciais ao fazer chamadas à API.
AUTH_ENABLED=false
AUTH_USER=admin
AUTH_PASS=netmonitor

# --- Limites de Monitoramento ---
# Número máximo de dispositivos que podem ser cadastrados
MAX_DEVICES=50

# Quantidade máxima de registros de histórico de latência por dispositivo
HISTORY_SIZE=100

